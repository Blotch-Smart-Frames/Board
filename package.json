{
  "name": "board-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@board/client",
    "start": "turbo run start --filter=@board/client",
    "build": "turbo run build --filter=@board/client",
    "test": "turbo run test --filter=@board/client",
    "dev:legacy": "turbo run dev --filter=@board/client-legacy",
    "build:legacy": "turbo run build --filter=@board/client-legacy",
    "test:legacy": "turbo run test --filter=@board/client-legacy",
    "lint:legacy": "turbo run lint --filter=@board/client-legacy",
    "format:legacy": "turbo run format --filter=@board/client-legacy",
    "cspell:legacy": "turbo run cspell --filter=@board/client-legacy",
    "build:all": "turbo run build",
    "test:all": "turbo run test",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "2.10.8"
  }
}
