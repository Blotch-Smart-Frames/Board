{
  "name": "@blotch/board-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*",
    "packages/.vite"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@blotch/board-client",
    "start": "turbo run start --filter=@blotch/board-client",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:ci:coverage": "turbo run test:ci:coverage",
    "build:functions": "turbo run build --filter=@blotch/board-functions",
    "test:functions": "turbo run test --filter=@blotch/board-functions",
    "deploy:functions": "npm run build:functions && firebase deploy --only functions",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "cspell": "turbo run cspell"
  },
  "devDependencies": {
    "cspell": "^9.6.2",
    "turbo": "2.10.8"
  }
}
