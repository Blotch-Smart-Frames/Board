  "patterns": [
    {
      "name": "google-api-key",
      "pattern": "AIza[0-9A-Za-z_-]{35}"
    },
    {
      "name": "build-hash-json",
      "pattern": "\"buildHash\"\\s*:\\s*\"[^\"]+\""
    }
  ],
  "ignoreRegExpList": [
    "google-api-key",
    "build-hash-json"
  ],
  "ignorePaths": [
    "node_modules",
    "dist",
    "dist-ssr",
    "coverage",
    "package-lock.json",
    "*.min.js",
    "*.svg",
    "*.tsbuildinfo",
    ".angular",
    ".turbo",
    ".firebase",
    ".env",
    ".env.*",
    ".claude",
    ".agents",
    "**/public/version.json"
  ]
}
